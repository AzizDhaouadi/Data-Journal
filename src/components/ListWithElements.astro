---
type Props = {
    title: string;
    data_component: string
}

type parameterObject = {
    name: string;
    value: string;
}

const { title, data_component } = Astro.props;
import data from "../../public/data/parameters.json";
const typedData = data as Record<string, { name: string; value: string }[]>;

---

<div class="w-full sm:w-80 bg-white border border-zinc-200 rounded-xl overflow-hidden">

  <div class="px-5 py-4 border-b border-zinc-100">
    <h2 class="text-sm font-semibold font-manrope text-zinc-800 tracking-wide uppercase">
      {title}
    </h2>
  </div>
  <ul class="list-none divide-y divide-zinc-100">
    {
      typedData[data_component]?.map((element: parameterObject) => (
        <li class="flex flex-row items-center justify-between gap-4 px-5 py-3">
          <p class="text-sm text-zinc-500 font-manrope">
            {element.name}
          </p>
          <span class="font-dm-mono text-xs text-zinc-700 bg-zinc-100 px-2.5 py-1 rounded-md whitespace-nowrap">
            {element.value}
          </span>
        </li>
      )) ?? (
        <li class="px-5 py-3 text-sm text-zinc-400 font-manrope italic">
          No data available
        </li>
      )
    }
  </ul>
</div>