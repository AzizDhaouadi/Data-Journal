---
type Props = {
  text: string;
  cta: string;
  link: string
}

const { text, cta, link } = Astro.props;
---

<!-- Announcement Bar -->
  <div class="bg-teal-900 text-white text-center py-2 relative">
    <p class="mb-0">
      {text}
      <a href={link} class="font-bold underline"
        class="font-bold underline">
        {cta}
    </a>
    </p>
  </div>