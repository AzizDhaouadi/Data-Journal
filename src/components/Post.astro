---
import { type CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
---

<article>
  <a
    href={`/${post.slug}/`}
    class="text-2xl hover:text-zinc-900 mb-4 font-semibold inline-block"
    style="color: #311c3b"
  >
    {post.data.title}
  </a>

  <p class="text-zinc-500 text-1xl mb-9">{post.data.date}</p>

  <p class="prose text-zinc-500 text-1xl mb-9 line-clamp-3 text-wrap">
    {post.body}
  </p>
</article>
