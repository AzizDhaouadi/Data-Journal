---
import { Image } from "astro:assets";
import AnnouncementBar from "./AnnouncementBar.astro";
---

<aside>
    <AnnouncementBar 
      text="Generate your GA4 Events with our free tool!"
      link="https://www.datakyu.co/resources/generate-ga4-events?utm_source=datakyu&utm_medium=referral&utm_campaign=generate-ga4-events"
      cta="Generate GA4 Events Now"
    />
</aside>
<header class="flex px-24 py-12 max-sm:px-5 max-sm:py-10 w-full mx-auto mb-10">
  <nav class="bg-white w-full border-gray-200">
    <div
      class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4"
    >
      <a href="/" class="flex gap-x-4 items-center">
        <Image
          src="/logo-transparent.svg"
          alt="Dataky's Official Logo"
          width={64}
          height={64}
          format="webp"
          class="w-40"
        />
      </a>
      <button
        data-collapse-toggle="navbar-default"
        type="button"
        class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400"
        aria-controls="navbar-default"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          class="w-5 h-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"></path>
        </svg>
      </button>
      <div class="hidden w-full md:block md:w-auto" id="navbar-default">
        <ul
          class="font-medium flex justify-between items-center flex-col p-4 md:p-0 mt-4 border border-gray-100 rounded-lg bg-gray-50 md:flex-row md:gap-4 md:space-x-8 md:mt-0 md:border-0 md:bg-white"
        >
          <li>
            <a href="/posts/" class="text-teal-800 font-bold">Posts</a>
          </li>
          <li>
            <a href="/search/" class="text-teal-800 font-bold">Search</a>
          </li>
          <li>
            <a href="/data-stories/" class="text-teal-800 font-bold">Data Stories</a>
          </li>
          <li>
            <a href="/ga4-api-reference/" class="text-teal-800 font-bold">GA4 API Parameters</a>
          </li>
          <li>
            <a href="/about/" class="text-teal-800 font-bold">About</a>
          </li>
          <li>
            <a href="https://www.datakyu.co" class="text-teal-800 font-bold"
              >Our Agency</a
            >
          </li>
          <li>
            <a
              href="https://www.datakyu.co/policies/privacy-policy.html"
              class="text-teal-800 font-bold">Privacy Policy</a
            >
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const toggleButton = document.querySelector("button[data-collapse-toggle]");
    const menu = document.getElementById("navbar-default");

    toggleButton.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
