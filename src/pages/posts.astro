---
import H1 from "../components/H1.astro";
import Main from "../components/Main.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Footer from "../components/Footer.astro";
import PostsWithImagination from "../components/client/PostsWithPagination";
const posts = await getCollection("posts");
---

<Layout
  title="Data Journal | All Posts"
  description="Explore all our published posts"
>
  <Main>
    <H1 text="All Posts" />
  </Main>
  <PostsWithImagination client:load pagePosts={posts}></PostsWithImagination>
  <Footer />
</Layout>
