---
import { slugify } from "../../utils/slug";
import { getCollection } from "astro:content";

import H1 from "../../components/H1.astro";
import Main from "../../components/Main.astro";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const dataStories = await getCollection("stories");
  const categories = [...new Set(dataStories.map((c) => c.data.category))];

  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: {
      category,
      cards: dataStories
        .filter((c) => c.data.category === category)
        .map((c) => c.data),
      allCategories: categories,
    },
  }));
}) satisfies GetStaticPaths;

const { category, cards, allCategories } = Astro.props;
---

<Layout
  title={`${category} questions - Data Stories`}
  description={`Common ${category} questions answered. Part of Data Stories by Datakyu`}
>
  <Main>
    <nav aria-label="Browse by topic" class="my-6 flex flex-wrap gap-2 mb-8">
      {
        allCategories.map((cat) => {
          const isCurrent = cat === category;
          const baseClasses = "inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium transition-colors";
          const stateClasses = isCurrent ? "bg-zinc-900 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200";
          return (
            <a class={`${baseClasses} ${stateClasses}`} href={`/data-stories/${slugify(cat)}/`}>
                {cat}
            </a>
          )
        })
      }
    </nav>
    <div class="mt-10 space-y-8">
      {
        cards.map((card) => {
          const id = slugify(card.question);
          return (
            <H1 text={`${card.category} Frequently Asked Questions`} />
            <article 
            id={id}
            class="scroll-mt-24 my-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md sm:p-8"
            >
              <h2 class="text-xl font-semibold tracking-tight text-slate-900 sm:text-2xl">
                <a href={`#${id}`} class="no-underline hover:underline underline-offset-4 decoration-slate-300">{card.question}</a>
              </h2>
              <p class="mt-3 text-base leading-relaxed text-slate-700 mb-3">{card.answer}</p>
              {card.links && card.links.length > 0 && (
                <aside class="mt-5  border-slate-100 pt-4">
                  <p class="text-sm font-medium text-slate-500 mt-3">Read more:</p>
                  <ul class="mt-2 space-y-1.5">
                    {card.links.map((link) => (
                      <li>
                        <a 
                        class="text-sm text-slate-700 underline underline-offset-2 decoration-slate-300 hover:decoration-slate-700"
                        href={link.href}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </aside>
              )}
            </article>
          );
        })
      }
    </div>
  </Main>
  <Footer />
</Layout>
