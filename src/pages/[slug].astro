---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Main from "../components/Main.astro";
import H1 from "../components/H1.astro";
import Footer from "../components/Footer.astro";
import BlogMeta from "../components/BlogMeta.astro";
import BlogPost from "../components/client/Post.tsx";
import ArticlesToArticleRecommandations from "../components/client/wrappers/ArticlesToArticleRecommendations.tsx";
import { render } from "astro:content";

export const getStaticPaths = async () => {
  const posts = await getCollection("posts");
  const paths = posts.map((post: any) => {
    return {
      params: {
        slug: post.id,
      },
      props: {
        post,
      },
    };
  });
  return paths;
};

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title=`Data Journal - ${post.data.title}` description={post.data.description}>
  <Main>
    <H1 text={post.data.title} />
    <BlogMeta post={post} author="aziz" />
    <div
      class="prose max-w-7xl mx-auto overflow-visible relative my-10 flex flex-row gap-8"
    >
      <!-- <Content /> -->
      <BlogPost client:load>
        <Content />
      </BlogPost>

      <div class="flex flex-col gap-4" id="side-section">
        <div class="flex flex-col gap-4" id="recommendations-section">
          <h2
            class="text-2xl mx-auto text-center font-extrabold text-gray-900 mb-4"
          >
            People also Read
          </h2>
          <ArticlesToArticleRecommandations client:only />
        </div>
        <div class="flex flex-col gap-4" id="newsletter-section">
          <h2
            class="text-3xl mx-auto text-center font-extrabold text-gray-900 mb-4"
          >
            Join our Newsletter
          </h2>
          <span class="text-xs text-center text-gray-600 mx-auto"
            >Stay updated with our newsletter featuring industry insights, and
            expert tips.</span
          >
          <aside class="overflow-hidden mx-auto my-10 relative">
            <script>
              //@ts-check
              document.addEventListener("DOMContentLoaded", () => {
                const hbsptScript = document.createElement("script");
                hbsptScript.src = "//js.hsforms.net/forms/embed/v2.js";
                document.body.appendChild(hbsptScript);
              });
            </script>
            <script>
              //@ts-nocheck
              function loadHubSpotForm() {
                if (window.hbspt) {
                  // Clear any existing form to avoid duplicates
                  const container = document.querySelector(".hs-form-frame");
                  if (container) {
                    container.innerHTML = "";
                  }

                  window.hbspt.forms.create({
                    region: "na1",
                    portalId: "44171646",
                    formId: "20a326d3-6194-4624-85e9-adeddd32ae3e",
                    target: ".hs-form-frame",
                  });
                }
              }

              // Load on initial page load
              document.addEventListener("DOMContentLoaded", loadHubSpotForm);
              // Listen for Astro's view transition events (if using View Transitions)
              document.addEventListener("astro:after-swap", loadHubSpotForm);
              document.addEventListener("astro:page-load", loadHubSpotForm);
            </script>
            <div
              class="hs-form-frame"
              data-region="na1"
              data-form-id="7440c38a-292c-45cc-80e6-41726d84861d"
              data-portal-id="44171646"
            >
            </div>
          </aside>
        </div>
      </div>
    </div>
    <style>
      @media (width < 1024px) {
        #side-section {
          display: none;
        }
      }
    </style>
  </Main>
  <Footer />
</Layout>

<script is:inline type="application/javascript" define:vars={{ post }}>
  window.addEventListener("DOMContentLoaded", () => {
    const blogpostSchema = {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "@id": `https://datajournal.datakyu.co/${post.id}/#BlogPosting`,
      mainEntityOfPage: `https://datajournal.datakyu.co/${post.id}/`,
      name: post.data.title,
      datePublished: new Date(post.data.date).toISOString(),
      dateModified: new Date(post.data.date).toISOString(),
      url: `https://datajournal.datakyu.co/${post.id}/`,
      isPartOf: {
        "@type": "Blog",
        "@id": "https://datajournal.datakyu.co/",
        name: "Data Journal by Datakyu",
        publisher: {
          "@type": "Organization",
          "@id": "https://www.datakyu.co/",
          url: "https://www.datakyu.co/",
          name: "Datakyu",
          logo: {
            "@type": "ImageObject",
            "@id": "https://www.datakyu.co/assets/logo/logo-transparent.svg",
            url: "https://www.datakyu.co/assets/logo/logo-transparent.svg",
          },
        },
      },
    };

    const blogPostStrucutredData = document.createElement("script");
    blogPostStrucutredData.setAttribute("type", "application/ld+json");
    blogPostStrucutredData.textContent = JSON.stringify(blogpostSchema);
    document.querySelector("head").appendChild(blogPostStrucutredData);
  });
</script>
