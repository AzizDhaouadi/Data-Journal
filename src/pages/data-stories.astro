---
import { getCollection } from "astro:content";
import { slugify } from "../utils/slug";

import H1 from "../components/H1.astro";
import Main from "../components/Main.astro";
import Layout from "../layouts/Layout.astro";
import DataStory from "../components/client/DataStory";
import Footer from "../components/Footer.astro";

const dataStories = await getCollection("stories");

const counts = dataStories.reduce<Record<string, number>>((acc, entry) => {
  const cat = entry.data.category;
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {});
const categories = Object.entries(counts).sort(([a], [b]) =>
  a.localeCompare(b),
);
const categoriesDescriptions = {
  "Google Tag Manager": "Common questions about GTM containers, dataLayer structure, triggers, and tag configuration — answered for analysts and developers shipping production tracking.",
  "Gtag": "How gtag.js actually works in the browser: consent commands, configuration parameters, event syntax, and the gotchas that show up between the docs and real implementations.",
  "Google Analytics 4": "Practical answers about GA4 — events, parameters, user identity, attribution, and the schema differences that trip up teams migrating from Universal Analytics.",
  "Google Ads": "Conversion tracking, enhanced conversions, audience signals, and the measurement infrastructure behind Google Ads campaigns — explained without the marketing gloss.",
  "Google Search Console": "What Search Console actually measures, how to read its reports, and how to use its data alongside GA4 and your own analytics warehouse."
}
---

<Layout
  title="Data Stories - Web Analytics Most Frequestly Asked Questions Answered"
  description="Discover expert answers to the most frequently asked web analytics questions. Learn how to track, analyze, and optimize data effectively."
>
  <Main>
    <H1 text="Data Stories: Your Web Analytics Library" />
    <p>
      Short answers to common questions in web analytics. Pick a topic to browse
      the questions in that area.
    </p>
    <div class="my-6 flex flex-row gap-3">
      {
        categories.map(([category, count]) => (
          <DataStory question={category} answer={count} link={`/data-stories/${category}/`} description={categoriesDescriptions[category as keyof typeof categoriesDescriptions]} />
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
